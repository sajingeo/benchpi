#!/usr/bin/env bash
# flash-probe: build and upload the benchprobe firmware to an Arduino.
#
#   flash-probe                          # Uno on /dev/benchprobe
#   flash-probe arduino:avr:nano /dev/ttyUSB0
#   flash-probe arduino:renesas_uno:minima /dev/ttyACM0
#
# FQBN = arduino-cli board name; install its core first:
#   arduino-cli core install <vendor:arch>

set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
sketch="$here/../benchprobe/firmware/benchprobe"

fqbn="${1:-arduino:avr:uno}"
port="${2:-${BENCHPROBE_PORT:-/dev/benchprobe}}"

[[ -e "$port" ]] || { echo "port $port not found; pass it explicitly (see bench-status)" >&2; exit 1; }

arduino-cli compile --fqbn "$fqbn" "$sketch"
arduino-cli upload --fqbn "$fqbn" --port "$(readlink -f "$port")" "$sketch"
echo "flashed benchprobe to $port ($fqbn). Try: benchprobe info"
